rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && (
        ('email_verified' in request.auth.token && request.auth.token.email_verified == true) ||
        ('phone_number' in request.auth.token && request.auth.token.phone_number is string && request.auth.token.phone_number.size() > 0 && request.auth.token.phone_number.size() <= 32)
      );
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        ('email' in request.auth.token && (request.auth.token.email == 'biplob168896@gmail.com' || request.auth.token.email == 'gg627263663@gmail.com') && 'email_verified' in request.auth.token && request.auth.token.email_verified == true) ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidPublicProfile(data) {
      return data.keys().hasAll(['uid', 'displayName', 'avatarInitial', 'authProvider', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'displayName', 'avatarInitial', 'authProvider', 'createdAt', 'updatedAt'])
        && isValidId(data.uid)
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 120
        && data.avatarInitial is string && data.avatarInitial.size() >= 1 && data.avatarInitial.size() <= 4
        && data.authProvider in ['GOOGLE', 'EMAIL', 'PHONE', 'WHATSAPP']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidPrivateInfo(data) {
      return data.keys().hasAll(['uid', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'email', 'phone', 'businessName', 'businessAddress', 'updatedAt'])
        && isValidId(data.uid)
        && (!('email' in data) || (data.email is string && data.email.size() <= 180))
        && (!('phone' in data) || (data.phone is string && data.phone.size() <= 32))
        && (!('businessName' in data) || (data.businessName is string && data.businessName.size() <= 120))
        && (!('businessAddress' in data) || (data.businessAddress is string && data.businessAddress.size() <= 250))
        && data.updatedAt is timestamp;
    }

    function isValidAdminRecord(data) {
      return data.keys().hasAll(['uid', 'email', 'createdAt'])
        && data.keys().hasOnly(['uid', 'email', 'createdAt'])
        && isValidId(data.uid)
        && data.email is string && data.email.size() <= 180
        && data.createdAt is timestamp;
    }

    match /users/{userId}/public/profile {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow create: if isValidId(userId)
        && isVerifiedUser()
        && isOwner(userId)
        && isValidPublicProfile(incoming())
        && incoming().uid == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(userId)
        && isVerifiedUser()
        && isValidPublicProfile(incoming())
        && (
          isAdmin() ||
          (
            isOwner(userId)
            && incoming().uid == existing().uid
            && incoming().createdAt == existing().createdAt
            && incoming().updatedAt == request.time
            && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'avatarInitial', 'authProvider', 'updatedAt'])
          )
        );
      allow delete: if isValidId(userId) && isAdmin();
    }

    match /users/{userId}/private/info {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow create: if isValidId(userId)
        && isVerifiedUser()
        && isOwner(userId)
        && isValidPrivateInfo(incoming())
        && incoming().uid == request.auth.uid
        && incoming().updatedAt == request.time;
      allow update: if isValidId(userId)
        && isVerifiedUser()
        && isValidPrivateInfo(incoming())
        && (
          isAdmin() ||
          (
            isOwner(userId)
            && incoming().uid == existing().uid
            && incoming().updatedAt == request.time
            && incoming().diff(existing()).affectedKeys().hasOnly(['email', 'phone', 'businessName', 'businessAddress', 'updatedAt'])
          )
        );
      allow delete: if isValidId(userId) && isAdmin();
    }

    match /admins/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow create: if isValidId(userId) && isAdmin() && isValidAdminRecord(incoming()) && incoming().createdAt == request.time;
      allow update: if isValidId(userId) && isAdmin() && isValidAdminRecord(incoming()) && incoming().uid == existing().uid && incoming().createdAt == existing().createdAt;
      allow delete: if isValidId(userId) && isAdmin();
    }
  }
}

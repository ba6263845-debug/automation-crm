# GEMINI_API_KEY: Required for server-side Gemini AI automation drafting & smart replies.
# AI Studio injects this at runtime; add it in Vercel Project Environment Variables for production.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Hosted URL of the application.
APP_URL="MY_APP_URL"

# JWT_SECRET: Long random secret string for signing stateless HMAC tokens & WhatsApp OTP cookies on Vercel.
JWT_SECRET="MY_LONG_RANDOM_JWT_SECRET"

# WHATSAPP_ACCESS_TOKEN & WHATSAPP_PHONE_NUMBER_ID:
# Meta WhatsApp Cloud API credentials for live WhatsApp OTP delivery and webhook replies.
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_OTP_TEMPLATE=""

# WEBHOOK_VERIFY_TOKEN: Meta Developer Webhook verification token for WhatsApp & Messenger endpoints.
WEBHOOK_VERIFY_TOKEN="automation_crm_verify_2026"

# ADMIN_EMAIL & ADMIN_PASSCODE: Hidden Master Admin credentials for Vercel / server-side Admin login.
ADMIN_EMAIL="biplob168896@gmail.com"
ADMIN_PASSCODE="168896"

# GEMINI_API_KEY: Required for server-side Gemini AI automation drafting & smart replies.
# AI Studio injects this at runtime.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Hosted URL of the application.
APP_URL="MY_APP_URL"

# WHATSAPP_ACCESS_TOKEN & WHATSAPP_PHONE_NUMBER_ID:
# Meta WhatsApp Cloud API credentials for live webhook replies (optional).
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""

# WEBHOOK_VERIFY_TOKEN: Meta Developer Webhook verification token for WhatsApp & Messenger endpoints.
WEBHOOK_VERIFY_TOKEN="automation_crm_verify_2026"

# Optional server-side Admin Credentials & Session Secret (configure in deployment secrets)
ADMIN_USERNAME="MY_ADMIN_USERNAME"
ADMIN_PASSWORD="MY_ADMIN_PASSWORD"
ADMIN_SESSION_SECRET="MY_ADMIN_SESSION_SECRET"
